          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "m365_service_status{customer=~\"$customer\",tenant=~\"$tenant\"} == 1",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Value": true
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
